# Ship these byte-for-byte: CI packages them straight into the release zip.
*.dll  binary

# Text files are normalised to LF in the repo (the CI runner is Linux).
*.md   text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf
*.cs   text eol=lf
*.py   text eol=lf
*.csproj text eol=lf
*.bbcode text eol=lf

# Ship the dash clip byte-for-byte.
*.wav  binary

# Screenshots for the mod page are hotlinked from the repo; ship them byte-for-byte.
*.jpg  binary
*.png  binary
